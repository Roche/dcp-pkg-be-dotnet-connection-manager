<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Roche/dcp-pkg-be-dotnet-connection-manager</RepositoryUrl>
    <PackageProjectUrl>https://open-dcp.ai/</PackageProjectUrl>
    <Version>0.10.0</Version>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="NuGet.Versioning" Version="6.14.0" />
    <PackageReference Include="OpenDCP.Framework.Configuration.Model" Version="0.3.0" />
    <PackageReference Include="OpenDCP.Framework.Exceptions" Version="0.1.1" />
    <PackageReference Include="OpenDCP.Framework.FormBuilder" Version="0.1.1" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
